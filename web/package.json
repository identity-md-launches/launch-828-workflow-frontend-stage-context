{
  "name": "pachu-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/manifest.mjs",
    "preview": "vite preview",
    "validate:export": "node scripts/manifest.mjs --check",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/interactions.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "viem": "2.57.3"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "playwright": "1.63.0",
    "typescript": "7.0.2",
    "vite": "8.3.3"
  }
}
